# Environment files — NEVER COMMIT CREDENTIALS OR SECRETS
.env
.env.*
!.env.example
*.env

# Dependencies
/backend/vendor/
vendor/
node_modules/

# Storage & logs
storage/logs/*
!storage/logs/.gitkeep
storage/cache/*
!storage/cache/.gitkeep
storage/sessions/*
!storage/sessions/.gitkeep
backend/storage/logs/*.log
*.log

# Public Uploads
public/uploads/*
!public/uploads/.gitkeep

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
