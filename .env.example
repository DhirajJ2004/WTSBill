# ==============================================================================
# WTSBill ERP — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize the parameters for your environment.
# NEVER commit the active .env file containing production secrets to version control.

# Application Environment
APP_NAME="WTSBill ERP"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://billing.wtsbill.in
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en_IN

# Trusted CORS Origins (comma-separated for REST API consumers)
ALLOWED_ORIGINS=https://billing.wtsbill.in,https://app.wtsbill.in

# Database Connection (MySQL 8.0+ / MariaDB 10.4+)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wtsbill_db
DB_USERNAME=wtsbill_user
DB_PASSWORD=YourStrongDatabasePasswordHere
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session Management
SESSION_DRIVER=file
SESSION_LIFETIME=7200
SESSION_COOKIE=wtsbill_session
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true

# Security Secrets & Cryptography
# Generate a strong 32-byte base64 key: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=base64:c29tZXJhbmRvbXNlY3JldGtleWZvcmJoYXJhdGxlZGdlcg==
JWT_SECRET=replace_with_a_secure_random_64_character_jwt_secret_token_here
BCRYPT_COST=12

# Performance & Caching
CACHE_DRIVER=file
CACHE_DEFAULT_TTL=3600
ENABLE_VIEW_CACHE=true
ENABLE_QUERY_CACHE=true

# Logging & Monitoring
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_MAX_FILES=30

# File Uploads & Backups
UPLOAD_MAX_FILESIZE=10M
BACKUP_STORAGE_PATH=/var/backups/wtsbill
