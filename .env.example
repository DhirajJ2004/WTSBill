# ==============================================================================
# WTSBill ERP - Environment Configuration Template
# ==============================================================================
# SECURITY NOTICE:
# 1. Never commit the actual .env file with real credentials or production secrets.
# 2. Previously exposed default keys (APP_KEY, JWT_SECRET) MUST be rotated
#    prior to deployment in staging or production.
# 3. In production, ensure APP_DEBUG is set to false.
# ==============================================================================

APP_NAME="WTSBill ERP"
APP_ENV=production
# Generate a new key using: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=base64:REPLACE_WITH_A_SECURE_RANDOM_32_BYTE_BASE64_KEY
# Set to false in production to prevent stack traces & internal info disclosure
APP_DEBUG=false
APP_URL=http://localhost:8000

# Trusted CORS origins (comma-separated list, NO wildcard '*')
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://localhost:5173

# Database Connection
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wtsbill_db
DB_USERNAME=wtsbill_user
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# JWT Secret - MUST BE ROTATED FROM PREVIOUS DEFAULT
# Generate a new secret using: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=REPLACE_WITH_SECURE_64_CHAR_HEX_SECRET

# Mail Configuration (for password reset links & alerts)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@wtsbill.in
MAIL_FROM_NAME="${APP_NAME}"
